---
import Icon from './Icon.astro';
import ServerRack from './ServerRack.astro';
import { serverBrands } from '../data/server-brands';

const positions = [
  [18, 19],
  [37, 7],
  [64, 7],
  [83, 19],
  [90, 43],
  [84, 70],
  [65, 87],
  [35, 87],
  [16, 70],
  [10, 43],
  [30, 45],
  [70, 45],
];
const connection = (x: number, y: number) =>
  `M500 414 C500 275 ${x * 10} 414 ${x * 10} ${y * 7}`;
---

<section
  id="manifesto"
  class="server-reveal-section"
  aria-labelledby="server-title"
>
  <div class="container">
    <div class="server-intro">
      <div>
        <span class="eyebrow reveal">
          <span class="section-label">02 /</span> Do metal ao modelo
        </span>
        <h2 id="server-title" class="section-heading text-reveal">
          Do datacenter
          <br />
          <span class="gradient-text">para grandes ideias.</span>
        </h2>
      </div>
      <div class="server-intro-copy reveal">
        <p>
          Aqui é <strong>troca real</strong>: open source, on-premise e gente
          que mete a mão na massa.
        </p>
        <span>Sem venda, sem paywall, sem palco.</span>
      </div>
    </div>
    <div class="server-universe" data-server-scene data-progress="0">
      <div class="server-scene-grid" aria-hidden="true"></div>
      <div class="server-orbit orbit-outside" aria-hidden="true"></div>
      <div class="server-orbit orbit-inside" aria-hidden="true"></div>
      <svg
        class="server-connections"
        viewBox="0 0 1000 700"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        {serverBrands.map((brand, i) => {
          const [x, y] = positions[i];
          const mx = i % 2 === 0 ? 12 : 88;
          const my = 11 + Math.floor(i / 2) * 15;
          return (
            <g
              class="server-connection"
              data-server-connection={i}
              style={`--wire-color:${brand.color}`}
            >
              <path
                class="wire-path wire-desktop"
                pathLength="1"
                d={connection(x, y)}
              />
              <path
                class="wire-path wire-mobile"
                pathLength="1"
                d={connection(mx, my)}
              />
              <path
                class="wire-packet wire-desktop"
                pathLength="1"
                d={connection(x, y)}
                style={`--packet-delay:${i * -0.6}s`}
              />
              <path
                class="wire-packet wire-mobile"
                pathLength="1"
                d={connection(mx, my)}
                style={`--packet-delay:${i * -0.6}s`}
              />
            </g>
          );
        })}
      </svg>
      <div class="server-core" data-server-core>
        <div class="rack-aura" aria-hidden="true"></div>
        <ServerRack />
        <span class="server-local-label">
          <i></i> ON-PREMISE / LOCAL FIRST
        </span>
      </div>
      <ul
        class="server-brands"
        aria-label="Tecnologias da comunidade IA na lata"
      >
        {serverBrands.map((brand, i) => {
          const [x, y] = positions[i];
          const mx = i % 2 === 0 ? 12 : 88;
          const my = 11 + Math.floor(i / 2) * 15;
          return (
            <li
              class="server-brand"
              data-server-brand={i}
              data-x={x}
              data-y={y}
              data-mx={mx}
              data-my={my}
              style={`--x:${x}%;--y:${y}%;--mx:${mx}%;--my:${my}%;--brand-color:${brand.color};--brand-delay:${i * -0.75}s`}
            >
              <div class="brand-plaque">
                <img
                  src={brand.src}
                  alt=""
                  aria-hidden="true"
                  width="32"
                  height="32"
                  loading="lazy"
                />
                <span>{brand.name}</span>
                <i class="brand-socket" aria-hidden="true"></i>
              </div>
            </li>
          );
        })}
      </ul>
      <div class="server-origin" aria-hidden="true">
        <span></span>
        <i></i>
        <span></span>
      </div>
    </div>
    <div class="server-bottom">
      <span class="server-scroll-note">
        <Icon name="arrow-down" size={13} />
        <span>Do hardware às ferramentas. Explore com o scroll.</span>
      </span>
      <a class="text-link" href="#stack">
        Ver a stack <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="server-credo reveal">
      <span>Compartilhe.</span>
      <i></i>
      <span>Aprenda.</span>
      <i></i>
      <span>Evolua.</span>
    </div>
  </div>
</section>
<script>
  import '../scripts/server-reveal';
</script>
<style>
  .server-reveal-section {
    position: relative;
    padding: 36px 0 88px;
    overflow: clip;
  }
  .server-intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 70px;
    align-items: end;
    position: relative;
    z-index: 2;
  }
  .server-intro .section-heading {
    font-size: 50px;
    line-height: 1.1;
    margin-top: 22px;
  }
  .server-intro-copy {
    padding-bottom: 5px;
    max-width: 320px;
    margin-left: auto;
  }
  .server-intro-copy p {
    color: #b8c9df;
    font-size: 14px;
    line-height: 1.85;
  }
  .server-intro-copy strong {
    font-weight: 500;
    color: #e9f1ff;
  }
  .server-intro-copy > span {
    display: block;
    margin-top: 13px;
    font-size: 11px;
    color: #94a8ca;
  }
  .server-universe {
    position: relative;
    height: 700px;
    margin: 35px -12px 0;
    isolation: isolate;
  }
  .server-scene-grid {
    position: absolute;
    inset: 9% -10%;
    background-image:
      linear-gradient(#71aeec0d 1px, transparent 1px),
      linear-gradient(90deg, #71aeec0d 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: radial-gradient(ellipse at center, black 5%, transparent 65%);
    transform: perspective(750px) rotateX(50deg) rotateZ(-8deg);
    z-index: 0;
  }
  .server-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1px solid #59a6ec18;
    border-radius: 50%;
    translate: -50% -50%;
    width: 91%;
    height: 67%;
    transform: rotate(-8deg);
    pointer-events: none;
    z-index: 0;
  }
  .orbit-inside {
    width: 65%;
    height: 54%;
    border-color: #8d80e126;
    transform: rotate(10deg);
  }
  .server-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .server-connection {
    --wire-progress: 1;
    opacity: var(--wire-opacity, 0.45);
  }
  .wire-path {
    stroke: var(--wire-color);
    stroke-width: 1;
    stroke-opacity: 0.6;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--wire-progress));
  }
  .wire-packet {
    stroke: var(--wire-color);
    stroke-width: 1.6;
    stroke-dasharray: 0.012 0.24;
    opacity: var(--wire-progress);
    animation: server-packet 4.5s var(--packet-delay) linear infinite;
    filter: drop-shadow(0 0 3px var(--wire-color));
  }
  .wire-mobile {
    display: none;
  }
  .server-core {
    isolation: isolate;
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 19%;
    width: 310px;
    height: 470px;
    translate: -50% 0;
    transform: translateY(var(--rack-y, 0px)) scale(var(--rack-scale, 1));
    pointer-events: none;
  }
  .rack-aura {
    position: absolute;
    z-index: -1;
    inset: 8% -25% -6%;
    background: radial-gradient(
      ellipse,
      #2e97ff2a 0%,
      #3739bb13 43%,
      transparent 69%
    );
    filter: blur(12px);
  }
  .server-local-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2%;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 1px;
    color: #afc9e7;
    white-space: nowrap;
  }
  .server-local-label i {
    height: 4px;
    width: 4px;
    border-radius: 50%;
    background: var(--led);
    box-shadow: 0 0 7px #39e6a877;
  }
  .server-brands {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .server-brand {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 3;
    width: 140px;
    opacity: var(--logo-opacity, 1);
    transform: translate(-50%, -50%)
      translate(var(--eject-x, 0px), var(--eject-y, 0px))
      scale(var(--eject-scale, 1)) rotate(var(--eject-rotation, 0deg));
    will-change: transform, opacity;
  }
  .brand-plaque {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 91px;
    padding: 14px 12px;
    background: linear-gradient(140deg, #142840e8, #0b182cec);
    border: 1px solid color-mix(in srgb, var(--brand-color) 34%, #5b759b22);
    border-radius: 12px;
    box-shadow:
      inset 0 1px 0 #cedfff09,
      0 12px 28px #0002;
    animation: brand-plaque-float 6.5s var(--brand-delay) ease-in-out infinite
      alternate;
    backdrop-filter: blur(9px);
  }
  .brand-plaque::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--brand-color),
      transparent
    );
    opacity: 0.55;
  }
  .brand-plaque img {
    display: block;
    width: 31px;
    height: 31px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }
  .brand-plaque span {
    font-size: 11px;
    color: #d7e5f7;
    line-height: 1.4;
    text-align: center;
  }
  .brand-socket {
    position: absolute;
    bottom: -3px;
    left: calc(50% - 2px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--brand-color);
    box-shadow: 0 0 9px var(--brand-color);
  }
  .server-origin {
    position: absolute;
    bottom: 5px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .server-origin > span {
    width: 90px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #749bc966);
  }
  .server-origin > span:last-child {
    rotate: 180deg;
  }
  .server-origin > i {
    height: 4px;
    width: 4px;
    background: var(--cyan);
    rotate: 45deg;
  }
  .server-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 14px;
    padding-bottom: 38px;
    border-bottom: 1px solid var(--line);
  }
  .server-scroll-note {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    color: #9eb5d2;
  }
  .server-scroll-note svg {
    color: var(--cyan);
  }
  .server-credo {
    display: flex;
    justify-content: center;
    gap: 30px;
    align-items: center;
    padding-top: 37px;
  }
  .server-credo span {
    font-size: 24px;
    font-weight: 450;
    letter-spacing: -0.8px;
    color: #b7c9e0;
  }
  .server-credo span:first-child {
    color: #a5deff;
  }
  .server-credo span:last-child {
    color: #b5a8f3;
  }
  .server-credo i {
    height: 4px;
    width: 4px;
    border-radius: 50%;
    background: #7286a377;
  }
  .server-universe:not(.is-in-view) *,
  .server-universe:not(.is-in-view) *::before {
    animation-play-state: paused;
  }
  @keyframes server-packet {
    to {
      stroke-dashoffset: -1;
    }
  }
  @keyframes brand-plaque-float {
    from {
      translate: 0 -4px;
    }
    to {
      translate: 0 5px;
    }
  }
  @media (max-width: 1000px) {
    .server-intro {
      gap: 35px;
    }
    .server-intro .section-heading {
      font-size: 43px;
    }
    .server-brand {
      width: 118px;
    }
    .brand-plaque {
      min-height: 83px;
      padding: 11px;
    }
    .server-core {
      width: 265px;
      height: 430px;
      top: 21%;
    }
    .server-universe {
      height: 650px;
    }
    .brand-plaque span {
      font-size: 10px;
    }
  }
  @media (max-width: 640px) {
    .server-reveal-section {
      padding: 6px 0 59px;
    }
    .server-intro {
      grid-template-columns: 1fr;
      gap: 23px;
    }
    .server-intro .section-heading {
      font-size: 37px;
      margin-top: 18px;
    }
    .server-intro-copy {
      margin-left: 0;
      max-width: none;
    }
    .server-intro-copy p {
      font-size: 13px;
    }
    .server-intro-copy > span {
      font-size: 10px;
      margin-top: 8px;
    }
    .server-universe {
      height: 630px;
      margin: 30px -7px 0;
    }
    .server-brand {
      left: var(--mx);
      top: var(--my);
      width: 80px;
    }
    .brand-plaque {
      min-height: 69px;
      padding: 9px 5px;
      gap: 6px;
      border-radius: 9px;
    }
    .brand-plaque img {
      height: 25px;
      width: 25px;
    }
    .brand-plaque span {
      font-size: 8px;
      line-height: 1.3;
    }
    .server-core {
      width: 176px;
      height: 358px;
      top: 24%;
    }
    .server-local-label {
      font-size: 5px;
      gap: 4px;
      letter-spacing: 0.2px;
      bottom: 5%;
    }
    .rack-aura {
      inset: 0 -50%;
    }
    .wire-desktop {
      display: none;
    }
    .wire-mobile {
      display: block;
    }
    .server-orbit {
      height: 90%;
      width: 97%;
      transform: rotate(-3deg);
    }
    .orbit-inside {
      width: 65%;
      height: 74%;
      transform: rotate(3deg);
    }
    .server-scene-grid {
      inset: 0 -5%;
      background-size: 32px 32px;
      transform: perspective(600px) rotateX(35deg);
    }
    .server-origin {
      bottom: 1px;
    }
    .server-bottom {
      padding-bottom: 26px;
      margin-top: 16px;
      gap: 15px;
    }
    .server-scroll-note {
      font-size: 8px;
      gap: 6px;
      max-width: 200px;
    }
    .server-bottom .text-link {
      font-size: 10px;
      white-space: nowrap;
    }
    .server-credo {
      gap: 15px;
      padding-top: 27px;
    }
    .server-credo span {
      font-size: 20px;
    }
    .server-credo i {
      width: 3px;
      height: 3px;
    }
  }
  @media (max-width: 360px) {
    .server-brand {
      width: 68px;
    }
    .brand-plaque span {
      font-size: 7px;
    }
    .server-core {
      width: 151px;
    }
    .server-credo {
      gap: 11px;
    }
    .server-credo span {
      font-size: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .server-brand,
    .server-core {
      transform: translate(-50%, -50%);
    }
    .server-core {
      transform: none;
    }
    .server-brand {
      opacity: 1;
    }
  }
  :global(html[data-motion='paused']) .server-brand {
    transform: translate(-50%, -50%);
    opacity: 1;
  }
  :global(html[data-motion='paused']) .server-core {
    transform: none;
  }
</style>
