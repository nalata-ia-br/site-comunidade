{
  "name": "ia-na-lata",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4322",
    "tunnel": "cloudflared tunnel --no-autoupdate run --url http://127.0.0.1:4322 --http-host-header localhost:4322 6fffe4a3-7ea1-4d47-8076-280a4ba4fabf",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test:e2e": "playwright test",
    "capture": "node scripts/capture.mjs",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json README.md",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.2",
    "motion": "^13.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
